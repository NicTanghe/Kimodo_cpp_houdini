diff --git a/include/kimodo/kimodo_capi.h b/include/kimodo/kimodo_capi.h
index d8c8df2..8292da8 100644
--- a/include/kimodo/kimodo_capi.h
+++ b/include/kimodo/kimodo_capi.h
@@ -53,6 +53,25 @@ typedef struct kimodo_generation_options {
     float constraint_cfg_weight;
 } kimodo_generation_options;
 
+/* Raw (unnormalized) smooth-root features and binary mask, [frames, 9+12*joints].
+ * Feature order: root xyz, heading cos/sin, root-relative joint xyz,
+ * world-space joint rotation 6D, velocities and contacts. Borrowed for the call.
+ */
+typedef struct kimodo_conditioning {
+    uint32_t size;
+    uint32_t frames;
+    uint32_t joints;
+    const float *values;
+    const float *mask;
+    float first_heading;
+} kimodo_conditioning;
+
+/* A null prompt uses a zero text embedding; otherwise a text model is required. */
+KIMODO_API kimodo_motion *kimodo_generate_conditioned(
+    kimodo_model *model, const char *prompt,
+    const kimodo_generation_options *options,
+    const kimodo_conditioning *conditioning, char *err, int err_len);
+
 /* A borrowed, row-major [1, 1, 4096] F32 LLM2Vec embedding. */
 typedef struct kimodo_embedding {
     const float *data;
diff --git a/src/capi.cpp b/src/capi.cpp
index 1aed86e..c24d7ff 100644
--- a/src/capi.cpp
+++ b/src/capi.cpp
@@ -62,6 +62,24 @@ kimodo_motion *kimodo_generate_embedding(kimodo_model *m, const kimodo_embedding
     } catch (const std::exception &x) { set_error(m, err, len, x.what()); return nullptr; }
     catch (...) { set_error(m, err, len, "unknown C++ exception"); return nullptr; }
 }
+kimodo_motion *kimodo_generate_conditioned(kimodo_model *m, const char *prompt,
+    const kimodo_generation_options *o, const kimodo_conditioning *c, char *err, int len) {
+    try {
+        std::string error;
+        if (!m || !m->value) { set_error(m,err,len,"invalid model"); return nullptr; }
+        if (!valid_options(o,error)) { set_error(m,err,len,error); return nullptr; }
+        if (!c || c->size!=sizeof(*c) || !c->values || !c->mask || c->frames!=o->frames) {
+            set_error(m,err,len,"invalid conditioning"); return nullptr;
+        }
+        std::array<float,kimodo::embedding_width> zero{};
+        auto result = prompt
+            ? m->value->generate_text(prompt,o->frames,o->diffusion_steps,o->seed,o->text_cfg_weight,o->constraint_cfg_weight,c)
+            : m->value->generate_embedding(zero,o->frames,o->diffusion_steps,o->seed,o->text_cfg_weight,o->constraint_cfg_weight,c);
+        if (!result) { set_error(m,err,len,result.error()); return nullptr; }
+        m->last_error.clear(); return new kimodo_motion{std::move(*result)};
+    } catch (const std::exception &e) { set_error(m,err,len,e.what()); return nullptr; }
+    catch (...) { set_error(m,err,len,"unknown C++ exception"); return nullptr; }
+}
 void kimodo_motion_free(kimodo_motion *m) { delete m; }
 int kimodo_motion_frames(const kimodo_motion *m) { return m ? static_cast<int>(m->value.frames) : 0; }
 int kimodo_motion_joints(const kimodo_motion *m) { return m ? static_cast<int>(m->value.joints) : 0; }
